# Contact form email (Hostinger Email). Copy to .env.local for local dev, or add these
# in the Hostinger Node.js app "Environment variables" section. NEVER commit real values.

# Required: password of the mailbox below
SMTP_PASS=

# Optional (these are the defaults)
SMTP_USER=contact@shivshaktiwaterequipment.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Where enquiries are delivered (default: SMTP_USER)
CONTACT_TO_EMAIL=contact@shivshaktiwaterequipment.com
# From address; Hostinger only accepts the authenticated mailbox (default: SMTP_USER)
SMTP_FROM=contact@shivshaktiwaterequipment.com
